NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/lymix?schema=public
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
OTP_PEPPER=CHANGE_ME_TO_A_SEPARATE_RANDOM_SECRET
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
ALLOW_DEV_OTP=false

# Owner/bootstrap account and real Prisma SUPER_ADMIN seed.
LYMIX_ADMIN_PHONE_E164=
LYMIX_ADMIN_LOGIN=
LYMIX_ADMIN_PASSWORD=
LYMIX_ADMIN_DISPLAY_NAME=Lymix Emre
LYMIX_ADMIN_USER_ID=owner_emre

# SUD
SUD_APP_ID=
SUD_APP_KEY=
SUD_APP_SECRET=
SUD_APP_SERVER_URL=
SUD_IS_TEST_ENV=true
SUD_CODE_TTL_MS=0
SUD_SSTOKEN_TTL_MS=0
SUD_API_CONFIG_CACHE_MS=86400000
SUD_VERIFY_CALLBACK_SIGNATURES=true
SUD_CALLBACK_MAX_SKEW_MS=300000
SUD_LEDGER_READY=false
SUD_ENABLE_ORDER_API=false
SUD_ENABLE_BATCH_ORDER_API=false
SUD_ENABLE_ROUND_BILL_API=false
SUD_ENABLE_ENTRY_SCORE_API=false
SUD_ENABLE_CROSS_APP_API=false
SUD_ENABLE_MATCHING_API=false
SUD_ENABLE_BULLET_API=false
